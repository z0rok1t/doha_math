# Auth.js session encryption key. Generate with: npx auth secret
AUTH_SECRET=

# GitHub OAuth app (Settings > Developer settings > OAuth Apps).
# Callback URL: https://<your-domain>/api/auth/callback/github
#           and http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Who may sign in to /admin. Both lists are checked; matching either is enough,
# and both are matched case-insensitively. Leaving BOTH empty locks everyone
# out — the check fails closed on purpose.
#
# ADMIN_LOGINS is the more reliable of the two: a GitHub account can keep its
# email private, and the address it signs commits with is often not its primary
# one, so an email-only allowlist is a common first-run lockout.
ADMIN_LOGINS=your-github-username
ADMIN_EMAILS=

# The repository the panel commits content to.
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main

# OAuth scope used to write content. "public_repo" is enough for a public
# repository; a private one needs the broader "repo".
GITHUB_OAUTH_SCOPE=public_repo
